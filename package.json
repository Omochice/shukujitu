{
  "name": "shukujitu",
  "version": "0.1.0",
  "private": true,
  "description": "Japanese public holidays as an iCalendar feed published on GitHub Pages",
  "license": "zlib",
  "author": "Omochice",
  "type": "module",
  "scripts": {
    "build": "node src/build.ts",
    "check": "npm-run-all2 check:*",
    "check:biome": "biome check .",
    "check:type": "tsrs -p .",
    "fmt": "run-p fmt:*",
    "fmt:biome": "biome check --write --unsafe .",
    "fmt:package": "sort-package-json",
    "test": "node --test"
  },
  "dependencies": {
    "@holiday-jp/holiday_jp": "2.5.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "mini-van-plate": "0.6.4",
    "npm-run-all2": "9.0.4",
    "sort-package-json": "4.1.0",
    "tsrs": "7.1.0-beta.tsrs3"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  }
}
